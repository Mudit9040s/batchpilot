# Login for the web portal (CHANGE THESE before deploying anywhere public!)
BATCHPILOT_USERNAME=admin
BATCHPILOT_PASSWORD=batchpilot
# Any long random string — keeps login sessions valid across restarts
BATCHPILOT_SECRET=

# Optional: enables AI validation. Without it, BatchPilot still works (rule-based only).
ANTHROPIC_API_KEY=

# Model used for AI validation
BATCHPILOT_AI_MODEL=claude-haiku-4-5-20251001

# Secrets referenced by profiles via ${VAR} substitution, e.g.:
TARGET_API_TOKEN=

# FieldAssist API credentials (used by profiles/fa-*.yaml)
FA_USERNAME=
FA_PASSWORD=

# FieldAssist DMS credentials (used by profiles/fa-dms-invoices.yaml)
FA_DMS_USERNAME=
FA_DMS_PASSWORD=
